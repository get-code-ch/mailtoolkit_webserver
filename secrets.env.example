# Model of /etc/mailtoolkit/secrets.env, read by deploy.sh; keep it out of
# the project. Empty values disable the service. One VAR=value per line, no
# quotes.
#
#   sudo install -d -m 750 -o "$USER" -g "$USER" /etc/mailtoolkit
#   install -m 600 secrets.env.example /etc/mailtoolkit/secrets.env
MTK_ABUSECH_KEY=
MTK_SAFEBROWSING_KEY=
MTK_VIRUSTOTAL_KEY=
MTK_SPAMHAUS_DQS_KEY=
MTK_ADMIN_TOKEN=
MTK_INGEST_TOKEN=
